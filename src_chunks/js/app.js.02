=String(appendixBlock(b).attrs?.align||'').toLowerCase();return ['left','right','center','justify'].includes(a)?' appendixAlign-'+a:''} function renderAppendixLooseText(a){const raw=Array.isArray(a?.blocks)&&a.blocks.length?a.blocks:(ownText(a)?[ownText(a)]:[]);if(!raw.length)return'';const blocks=raw.map(appendixBlock);const classes=blocks.map(b=>String(b.text).match(/^\s*(S\d+)\s*:\s*(.+)$/i));if(blocks.length>1&&classes.every(Boolean)){return `<section class="appendixLooseGroup"><div class="appendixClassList">${classes.map((m,i)=>`<div class="appendixClassRow${appendixAlignClass(blocks[i])}"><strong>${esc(m[1])}</strong><span>${renderInline(a,m[2])}</span></div>`).join('')}</div></section>`}return `<div class="appendixLooseText">${blocks.map(b=>`<p class="appendixSourceParagraph${appendixAlignClass(b)}" style="--appendix-indent:${Math.max(0,Number(b.indent)||0)}">${renderInline(a,b.text)}</p>`).join('')}</div>`}
function renderSourceTable(t){const cols=Array.isArray(t.columns)?t.columns:[];const rows=Array.isArray(t.rows)?t.rows:[];const source=state.viewer.node;return `<div class="appendixSourceTableWrap"><table class="legalTable appendixSourceTable">${cols.length?`<colgroup>${cols.map(c=>`<col${c.colwidth?` style="width:${esc(c.colwidth)}"`:''}>`).join('')}</colgroup>`:''}<tbody>${rows.map(r=>`<tr>${r.map(c=>{const x=typeof c==='object'?c:{text:String(c??'')};const tag=x.header?'th':'td';return `<${tag}${x.rowspan>1?` rowspan="${x.rowspan}"`:''}${x.colspan>1?` colspan="${x.colspan}"`:''}>${renderInline(source,x.text||'')}</${tag}>`}).join('')}</tr>`).join('')}</tbody></table></div>`}
function renderAppendixSourceNode(x,depth=0){if(!x)return'';const k=x.kind||'container';if(k==='table')return renderSourceTable(x);if(k==='heading'){const txt=[x.number,x.title].filter(Boolean).join(' ');return `<div class="appendixSourceHeading appendixSourceDepth${Math.min(depth,5)}">${esc(txt||x.text||'')}</div>`}if(k==='paragraph')return `<p class="appendixSourceParagraph appendixSourceDepth${Math.min(depth,5)}">${renderInline(state.viewer.node,x.text||'')}</p>`;if(k==='list_item'){const no=x.number?normalizeEnumDisplay(x.number):'';return `<div class="appendixSourceListItem appendixSourceDepth${Math.min(depth,5)}"><span class="appendixSourceEnum">${esc(no)}</span><div>${x.text?`<div>${renderInline(state.viewer.node,x.text)}</div>`:''}${(x.children||[]).map(c=>renderAppendixSourceNode(c,depth+1)).join('')}</div></div>`}const head=[x.number,x.title].filter(Boolean).join(' ');return `<section class="appendixSourceContainer appendixSourceDepth${Math.min(depth,5)}">${head?`<div class="appendixSourceHeading">${esc(head)}</div>`:''}${x.text?`<div class="appendixSourceOwnText">${renderInline(state.viewer.node,x.text)}</div>`:''}${(x.children||[]).map(c=>renderAppendixSourceNode(c,depth+1)).join('')}</section>`}
function normalizeEnumDisplay(v){v=String(v||'').trim();if(/^[a-z]$/i.test(v))return v.toLowerCase()+'.';return v.replace(/º/g,'°').replace(/^(\d+)\.$/,'$1')}
function renderAppendixView(a){const kids=children(a);const short=appendixShortTitle(a);const tree=Array.isArray(a.source_tree)?a.source_tree:[];const content=tree.length?tree.map(x=>renderAppendixSourceNode(x,0)).join(''):renderAppendixLooseText(a)+kids.map((k,i)=>renderAppendixPart(k,0,i+1)).join('');return `<section class="appendixView"><header class="appendixHeader"><h2>Bijlage ${esc(num(a))}</h2>${short?`<div class="appendixSubtitle">${esc(short)}</div>`:''}</header>${renderAppendixArticleLinks(a)}<div class="appendixContent appendixSourceContent">${content}</div></section>`}
function renderAppendixPart(n,depth=0,seq=1){if(type(n)==='table')return `<div class="appendixTable">${renderAttachment(n)}</div>`;const kids=children(n);const no=num(n);const heading=label(n);const text=ownText(n);const isItem=['member','item'].includes(type(n));const cls=`appendixPart appendixDepth${Math.min(depth,4)}${isItem?' appendixEnumerated':''}`;const head=heading&&heading!==text?`<div class="appendixPartHead">${esc(heading)}</div>`:'';const body=text?`<div class="appendixPartText">${renderInline(n,text)}</div>`:'';const inner=kids.length?`<div class="appendixSubparts">${kids.map((k,i)=>renderAppendixPart(k,depth+1,i+1)).join('')}</div>`:'';if(isItem&&no)return `<div class="${cls}"><div class="appendixEnum"><span class="appendixEnumNo">${esc(no)}</span><div>${body}${inner}</div></div></div>`;return `<section class="${cls}">${head}${body}${inner}</section>`}

function inlineArticleAttachments(ar){
 if(!ar)return[];
 const ids=Array.isArray(ar.article_attachments)?ar.article_attachments:[];
 return ids.map(id=>node(id,ar.regId)).filter(x=>['table','appendix'].includes(type(x))&&x.display_mode==='inline');
}
function renderArticle(ar){
 const inlineAt=inlineArticleAttachments(ar);
 const inlineIds=new Set(inlineAt.map(nid));
 const bodyChildren=children(ar).map(k=>renderArticleChild(k,ar,inlineIds)).join('');
 // Niet iedere BWB-tabel hangt als direct child in de graph. article_attachments is
 // daarom de structurele bron voor de fallback. Voeg alleen nog niet gerenderde tabellen toe.
 const rendered=new Set();
 const collect=n=>{if(!n||rendered.has(nid(n)))return;rendered.add(nid(n));for(const c of children(n))collect(c)};
 for(const c of children(ar))collect(c);
 const fallback=inlineAt.filter(a=>!rendered.has(nid(a))).map(renderAttachment).join('');
 return `<article><div class="legalHead">${esc(label(ar))}</div>${ownText(ar)?`<div class="legalText">${renderInline(ar,ownText(ar))}</div>`:''}<div class="legalChildren">${bodyChildren}${fallback}</div></article>`;
}
function renderArticleChild(n,ar,inlineIds=new Set()){if(['table','appendix'].includes(type(n))){if(inlineIds.has(nid(n)))return renderAttachment(n);if(isReliableAttachment(n))return'';return renderAttachment(n)}const no=num(n);const body=ownText(n);const childHtml=children(n).map(k=>renderArticleChild(k,ar,inlineIds)).join('');const content=body?renderInline(n,body):'';return `<div class="legalNode" data-content-node="${esc(nid(n))}">${no?`<div class="enumeration"><span class="enumNum">${esc(no)}</span><div>${content}</div></div>`:`<div class="legalText">${content}</div>`}${childHtml?`<div class="legalChildren">${childHtml}</div>`:''}</div>`}
function renderAttachment(a){if(type(a)==='table')return `<div class="attachmentBlock"><div class="sideTitle">${esc(label(a))}</div>${renderTable(a)}</div>`;if(type(a)==='appendix')return `<div class="attachmentBlock sideAppendix">${renderAppendixView(a)}</div>`;return `<div class="attachmentBlock"><div class="sideTitle">${esc(label(a))}</div><div class="legalText">${renderInline(a,ownText(a))}</div>${children(a).map(x=>renderArticleChild(x,articleOf(a))).join('')}</div>`}
function tableColgroup(t){const cols=Array.isArray(t.columns)?t.columns:[];if(!cols.length)return'';const stars=cols.map(c=>{const m=String(c?.colwidth||'').match(/^([0-9.]+)\*$/);return m?Number(m[1]):0}),sum=stars.reduce((a,b)=>a+b,0);return `<colgroup>${cols.map((c,