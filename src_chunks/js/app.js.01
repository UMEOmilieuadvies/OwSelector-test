on').textContent=queryFavorite()?'★':'☆'}
function renderHistory(){const data=state.historyTab==='favorites'?favorites():history();const box=$('historyPanel');box.innerHTML=data.slice(0,7).map((x,i)=>`<button class="historyItem" data-history="${i}">${esc(x.label||x.query||'')}</button>`).join('')||'<div class="empty">Geen items.</div>';box.hidden=false}
function closeHistory(){$('historyPanel').hidden=true}
function setStatus(s){$('status').textContent=s}
function clearSide(){state.side={article:null,selected:null};renderSide()}
function syncSideForViewer(n){if(type(n)==='article'){state.side={article:n,selected:null};renderSide()}else clearSide()}
function clearSearch(){state.search={query:'',results:[],active:false};$('resultCount').textContent=''}
function renderNavigation(){const box=$('navigation');$('navRegulationLabel').textContent=`Zoeken in: ${regName(state.regulation)}`;const rs=roots(state.regulation);if(!rs.length){box.innerHTML='<div class="empty">Geen navigatie beschikbaar.</div>';return}box.innerHTML=rs.map(n=>renderNavNode(n,0)).join('')}
function renderNavNode(n,depth){const kids=navChildren(n),expanded=state.navigation.expanded.has(nid(n)),selected=nid(state.navigation.selected)===nid(n);return `<div class="navNode"><button class="navRow ${selected?'selected':''}" data-nav="${esc(nid(n))}"><span class="chev">${kids.length?(expanded?'⌄':'›'):'•'}</span><span>${esc(label(n))}</span></button>${expanded&&kids.length?`<div class="navChildren">${kids.map(x=>renderNavNode(x,depth+1)).join('')}</div>`:''}</div>`}
function expandPath(n){state.navigation.expanded.clear();for(const x of ancestors(n))if(type(x)!=='article')state.navigation.expanded.add(nid(x))}
function selectNavigation(n){clearSearch();state.navigation.selected=n;state.viewer={node:n,trail:ancestors(n),regulation:state.regulation};clearSide();if(type(n)!=='article'){if(state.navigation.expanded.has(nid(n)))state.navigation.expanded.delete(nid(n));else state.navigation.expanded.add(nid(n))}renderNavigation();renderViewer();setStatus(`${label(n)} geselecteerd in navigatie.`);log('NAV_SELECT',{id:nid(n),type:type(n)})}
function renderViewer(){const box=$('viewer');if(state.search.active){renderSearchResults();return}if(state.viewer.overview){const rs=roots(state.regulation);box.innerHTML=`<div class="breadcrumb"><span>${esc(regName(state.regulation))}</span></div><div class="regulationOverview">${rs.map(n=>`<button class="overviewNode" data-view-node="${esc(nid(n))}">${esc(label(n))}</button>`).join('')||'<div class="empty">Geen hoofdstukken of bijlagen beschikbaar.</div>'}</div>`;return}const n=state.viewer.node;if(!n){box.innerHTML='<div class="empty">Selecteer een element in de navigatie of voer een zoekopdracht uit.</div>';return}const trail=state.viewer.trail;const crumb=trail.map((x,i)=>{const prefix=(i===0||trail[i-1]?.regId!==x.regId)?regName(x.regId)+' — ':'';return i===trail.length-1?`<div class="breadcrumbStep current"><span>${esc(prefix+label(x))}</span></div>`:`<div class="breadcrumbStep"><button data-crumb="${i}">${esc(prefix+label(x))}</button></div>`}).join('');box.innerHTML=`${crumb?`<div class="breadcrumb">${crumb}</div>`:''}<div class="viewerContent">${renderNodeView(n)}</div>`;bindInlineLinks(box)}
function searchResultBreadcrumb(r){const path=ancestors(r.node).slice(0,-1).filter(n=>['chapter','section','paragraph','subparagraph'].includes(type(n)));const reg=`<button class="resultCrumb" data-result-reg="${esc(state.regulation)}">${esc(regName(state.regulation))}</button>`;const rest=path.map(n=>`<span class="crumbSep">›</span><button class="resultCrumb" data-result-crumb="${esc(nid(n))}">${esc(label(n))}</button>`).join('');return `<div class="resultBreadcrumb">${reg}${rest}</div>`}
function renderSearchResults(){const box=$('viewer'),items=state.search.results;$('resultCount').textContent=`${items.length} resultaat${items.length===1?'':'en'}`;if(!items.length){box.innerHTML='<div class="empty">Geen zoekresultaten.</div>';return}box.innerHTML=`<div class="resultList">${items.slice(0,200).map((r,i)=>`<div class="searchResult" data-result="${i}">${searchResultBreadcrumb(r)}<div class="resultTitle">${esc(label(r.node))}</div><div class="resultSnippet">${highlight(snippet(resultSource(r),state.search.query),state.search.query)}</div></div>`).join('')}</div>${items.length>200?`<div class="empty">Eerste 200 van ${items.length} resultaten weergegeven.</div>`:''}`}
function openSearchBreadcrumbNode(n){if(!n)return;state.search.active=false;state.viewer={node:n,trail:ancestors(n),overview:false,regulation:state.regulation};clearSide();renderViewer();setStatus(`${label(n)} geopend vanuit het kruimelpad van een zoekresultaat.`);log('SEARCH_BREADCRUMB_OPEN',{id:nid(n),type:type(n)})}
function openSearchRegulation(){state.search.active=false;state.viewer={node:null,trail:[],overview:true,regulation:state.regulation};clearSide();renderViewer();setStatus(`${regName(state.regulation)} geopend vanuit het kruimelpad van een zoekresultaat.`);log('SEARCH_BREADCRUMB_REGULATION',{reg:state.regulation})}
function renderNodeView(n){if(isGlossaryAppendix(n))return renderGlossaryAppendix();if(type(n)==='appendix')return renderAppendixView(n);if(type(n)==='article')return renderArticle(n);const kids=legalChildren(n);return `<div class="legalNode"><div class="legalHead">${esc(label(n))}</div>${ownText(n)?`<div class="legalText">${renderInline(n,ownText(n))}</div>`:''}${kids.length?`<div class="legalChildren">${kids.map(k=>`<div class="legalNode clickable" data-view-node="${esc(nid(k))}"><div class="legalHead legalLinkVisual">${esc(label(k))}</div>${ownText(k)?`<div class="legalText">${renderInline(k,ownText(k))}</div>`:''}</div>`).join('')}</div>`:''}</div>`}
function appendixShortTitle(a){const t=String(a?.title||'').trim();const m=t.match(/\(([^()]*)\)\s*$/);return m?m[1].replace(/^./,c=>c.toUpperCase()):''}
function appendixArticleNumbers(a){const t=String(a?.title||'');const before=t.replace(/\([^()]*\)\s*$/,'');const m=before.match(/artikelen?\s+(.+?)(?:\s+van\s+dit\s+besluit|$)/i);return m?[...m[1].matchAll(/\b\d+(?:\.\d+)+[a-z]?\b/gi)].map(x=>x[0]):[]}
function renderAppendixArticleLinks(a){const nums=appendixArticleNumbers(a);if(!nums.length)return'';return `<div class="appendixBelongs"><div class="appendixBelongsTitle">Behoort bij ${nums.length===1?'artikel':'artikelen'}</div><div class="appendixBelongsLinks appendixArticleList">${nums.map(no=>{const t=resolveRef('artikel '+no,a.regId);const title=String(t?.title||'').trim().replace(/^\((.*)\)$/,'$1');const link=t?`<button class="legalLink" data-inline="${esc(nid(t))}">${esc(no)}</button>`:`<span class="appendixArticleNumber">${esc(no)}</span>`;return `<div class="appendixArticleRow">${link}${title?`<span class="appendixArticleDescription">${esc(title)}</span>`:''}</div>`}).join('')}</div></div>`}
function appendixBlock(b){return typeof b==='object'&&b?b:{text:String(b??''),indent:0,attrs:{}}} function appendixAlignClass(b){const a=